{
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "frontend/dist/client",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/server" },

    { "source": "/sitemap.xml", "destination": "/api/sitemap" },

    { "source": "/", "destination": "/api/ssr" },
    {
      "source": "/(courses|videos|lessons|articles|contact|about|app|pages)",
      "destination": "/api/ssr"
    },
    { "source": "/courses/:id", "destination": "/api/ssr" },
    { "source": "/lessons/:id", "destination": "/api/ssr" },
    { "source": "/articles/:slug", "destination": "/api/ssr" },
    { "source": "/page/:slug", "destination": "/api/ssr" },
    {
      "source": "/(login|register|member|dashboard|booking|my-bookings|coach|chat|notifications|notes|checkout)",
      "destination": "/app-shell.html"
    },
    { "source": "/chat/:conversationId", "destination": "/app-shell.html" },
    { "source": "/checkout/success", "destination": "/app-shell.html" },
    { "source": "/admin", "destination": "/app-shell.html" },
    { "source": "/admin/:path*", "destination": "/app-shell.html" },

    { "source": "/(.*)", "destination": "/api/not-found" }
  ],
  "functions": {
    "api/server.js": {
      "maxDuration": 10,
      "includeFiles": "backend/dist/**"
    },
    "api/ssr.js": {
      "maxDuration": 10,
      "includeFiles": "api/_ssr_template.html"
    },
    "api/not-found.js": {
      "maxDuration": 10
    },
    "api/sitemap.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/cleanup-chat",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/cleanup-images",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/smoke",
      "schedule": "0 21 * * *"
    }
  ],
  "headers": [
    {
      "source": "/app-shell.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
