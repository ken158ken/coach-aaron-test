# Vercel 部署時忽略的檔案

# Node modules - Vercel 會自動安裝
node_modules/

# 開發檔案
*.log
.DS_Store
.env.local
.env.*.local

# 測試檔案
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# 文件（太大，但保留 README.md）
REPORTS/
DEPLOYMENT-CHECKLIST.md
GIT_PUSH_GUIDE.md
IMAGE_OPTIMIZATION_GUIDE.md
SSR-CHECK-REPORT.md
VERCEL_DEPLOYMENT_GUIDE.md
ADMIN_PAGES_MIGRATION_SUMMARY.md

# 資料庫檔案（不需要部署）
database/

# 腳本（保留 vercel-build.sh）

# 其他專案檔案（如果存在）
舊專案前端參考/
參考/
私人教練陪跑/

# 前端開發用檔案（僅排除非構建必要的檔案）
frontend/public/*.md

# 編輯器配置
.vscode/
.idea/
