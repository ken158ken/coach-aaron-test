.vercel
.env*.local

# One-time local migration / import scripts (may contain hardcoded keys)
backend/import_*.mjs
backend/migrate_*.mjs

# Supabase DB snapshot（含真實資料，僅供本機 review，不上 git）
database/snapshot/
# Snapshot 工具（內含 service-role key 硬編，僅供本機使用）
database/dump_snapshot.mjs

# Flutter / Android
mobile/**/.dart_tool/
mobile/**/.flutter-plugins
mobile/**/.flutter-plugins-dependencies
mobile/**/build/
mobile/**/.gradle/
mobile/**/local.properties
mobile/**/key.properties
mobile/**/*.keystore
mobile/**/*.jks
# Firebase 設定（含 OAuth client id，雖非高敏感但避免推上公開 repo）
mobile/**/google-services.json
mobile/**/GoogleService-Info.plist
# Service account 私鑰（後端推播用）
firebase-service-account.json
*-firebase-adminsdk-*.json

